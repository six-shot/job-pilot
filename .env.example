# The two people allowed in, as username:password pairs separated by ";".
# The first one listed is the owner. Leave empty to run without sign-in (just you, on your own computer).
JOBPILOT_USERS=okhuomon:choose-a-password;friend:choose-another-password

# Long random string that signs sign-in cookies. Required when JOBPILOT_USERS is set.
SESSION_SECRET=

# Anthropic API key for CV tailoring (https://console.anthropic.com/settings/keys).
# Leave empty to use your Claude subscription through Claude Code on this computer.
ANTHROPIC_API_KEY=

# ISO-3166 alpha-3 code of where you live; roles closed to it are hidden by default
HOME_COUNTRY=NGA
